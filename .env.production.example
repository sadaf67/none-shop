# Copy this file to .env.production. Never commit the real file.
# Replace example.com with the real domain before the first start.

DEBUG=False
SECRET_KEY=CHANGE_ME_WITH_AT_LEAST_64_RANDOM_CHARACTERS
ALLOWED_HOSTS=example.com,www.example.com,backend,localhost
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=https://example.com

# Keep POSTGRES_PASSWORD URL-safe (letters, numbers, underscore, hyphen).
# The password in DATABASE_URL must exactly match POSTGRES_PASSWORD.
POSTGRES_DB=n_one
POSTGRES_USER=n_one
POSTGRES_PASSWORD=CHANGE_ME_DATABASE_PASSWORD
DATABASE_URL=postgresql://n_one:CHANGE_ME_DATABASE_PASSWORD@db:5432/n_one
DB_CONN_MAX_AGE=60
DB_SSLMODE=disable

STATIC_ROOT=/var/www/static
MEDIA_ROOT=/var/www/media
DJANGO_ADMIN_PATH=django-admin/
ENABLE_API_DOCS=False

SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=7
API_PAGE_SIZE=12
API_ANON_RATE=120/min
API_USER_RATE=600/min
API_AUTH_RATE=10/min
ORDER_RESERVATION_MINUTES=30
PAYMENT_AUTHORITY_REUSE_MINUTES=20
PAYMENT_RESERVATION_MINUTES=120
FREE_SHIPPING_THRESHOLD=500000
FLAT_SHIPPING_COST=30000

# A real production merchant ID is required for live payments.
# The admin panel (/admin/settings) can override the gateway and merchant ID at runtime.
ZARINPAL_MERCHANT_ID=CHANGE_ME_WITH_REAL_MERCHANT_ID
ZARINPAL_SANDBOX=False

# SMS provider credentials are NOT set here.
# Enter them in the admin panel (/admin/settings, SMS tab); they are stored in the
# database and never exposed by the public settings endpoint.

DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
LOG_LEVEL=INFO
GUNICORN_WORKERS=3
TZ=Asia/Tehran

# Keep this bound to loopback when Caddy/Nginx on the host handles TLS.
APP_HTTP_BIND=127.0.0.1
APP_HTTP_PORT=8080
